# ── 24 Frames · Private Studio Commission Experience ──────────────────────────
# Copy to .env.local (development) or set in your hosting provider (production).

# Required. Numeric or alphanumeric PIN the consultant enters at /quotebuilder/login.
# Use at least 6 characters.
STUDIO_PIN=

# Required. Random secret (>= 32 chars) used to sign studio session cookies.
# Generate with: openssl rand -hex 32
STUDIO_SESSION_SECRET=

# Production storage: any PostgreSQL connection string (Supabase recommended).
# Supabase → Connect → "Transaction pooler" URI (port 6543), with your
# database password filled in. POSTGRES_URL is also accepted.
# Tables are created automatically in a private `studio` schema.
DATABASE_URL=

# Optional, local only: without DATABASE_URL, records are stored as JSON in
# this directory (default ./.studio-data). Not usable on serverless hosts.
STUDIO_DATA_DIR=

# Optional. WhatsApp Business Cloud API — enables automated PDF document delivery.
# Leave blank to use the manual share workflow (click-to-chat + attach PDF).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
