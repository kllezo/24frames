# ── 24 Frames · Private Studio Commission Experience ──────────────────────────
# Copy to .env.local (development) or set in your hosting provider (production).

# Required. Numeric or alphanumeric PIN the consultant enters at /quotebuilder/login.
# Use at least 6 characters.
STUDIO_PIN=

# Required. Random secret (>= 32 chars) used to sign studio session cookies.
# Generate with: openssl rand -hex 32
STUDIO_SESSION_SECRET=

# Optional. Directory where commission records and studio configuration are
# stored (JSON, file permissions 0600). Defaults to ./.studio-data
# NOTE: serverless hosts (e.g. Vercel) have a read-only filesystem — swap the
# repository adapter in src/lib/studio/server/repository.ts for a database
# (Postgres, etc.) before deploying there.
STUDIO_DATA_DIR=

# Optional. WhatsApp Business Cloud API — enables automated PDF document delivery.
# Leave blank to use the manual share workflow (click-to-chat + attach PDF).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
