  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "perf": "npm run perf:desktop && npm run perf:mobile",
    "perf:desktop": "sitespeed.io tests/perf/urls.txt --config tests/perf/desktop-config.json",
    "perf:mobile": "sitespeed.io tests/perf/urls.txt --config tests/perf/mobile-config.json",
    "seed:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/studio/resolve-ts.mjs scripts/seed-portal-demo.mts",
    "test:studio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/studio/resolve-ts.mjs --test tests/studio/commission.test.mts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-pdf/renderer": "^4.9.0",
    "@types/three": "^0.186.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "16.4.3",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sitespeed.io": "^42.10.0",
    "typescript": "^5"
  }
}
